<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Adm.Testing\Adm.Testing.csproj" />
    <ProjectReference Include="..\..\src\Adm.Server.Host\Adm.Server.Host.csproj" />
  </ItemGroup>

  <Target Name="CopyServerWebAssetsForIntegrationTests" AfterTargets="Build">
    <ItemGroup>
      <ServerWebAssetFiles Include="$(MSBuildThisFileDirectory)..\..\artifacts\bin\Adm.Server.Host\$(Configuration)\net10.0\wwwroot\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)wwwroot" />
    <Copy SourceFiles="@(ServerWebAssetFiles)" DestinationFiles="@(ServerWebAssetFiles->'$(TargetDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
