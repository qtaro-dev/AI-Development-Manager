<Window x:Class="Adm.Poc.P1029.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="P1-029 WebView2 Offline UI PoC"
        Width="1280"
        Height="820"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <DockPanel Background="#101522">
        <Border DockPanel.Dock="Top" Padding="12" Background="#1C2638">
            <StackPanel>
                <TextBlock Foreground="#F5F7FF" FontSize="16" FontWeight="SemiBold" Text="P1-029 WebView2 Offline UI PoC" />
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="#B9C6DF" Text="初期化しています。" />
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="WebView" />
    </DockPanel>
</Window>
