<Window x:Class="Adm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Development Manager"
        Width="1280"
        Height="820"
        MinWidth="720"
        MinHeight="480"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid Background="#111622">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,10" Background="#1D2535">
            <DockPanel LastChildFill="True">
                <Button x:Name="RetryButton"
                        Width="92"
                        Height="32"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Click="RetryButton_Click"
                        Content="再試行"
                        IsEnabled="False" />
                <Button x:Name="ExitButton"
                        Width="72"
                        Height="32"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Click="ExitButton_Click"
                        Content="終了" />
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#F5F7FF" Text="AI Development Manager" />
                    <TextBlock x:Name="StatusText" Margin="0,3,0,0" Foreground="#B6C1D9" Text="接続を準備しています。" />
                    <TextBlock x:Name="ServerUrlText" Margin="0,2,0,0" Foreground="#8996B5" Text="Server: -" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WebView"
                          MinWidth="0"
                          MinHeight="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Visibility="Collapsed" />
            <Border x:Name="MessagePanel" Margin="28" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1D2535" CornerRadius="10">
                <StackPanel Width="520">
                    <TextBlock x:Name="MessageTitle" FontSize="22" FontWeight="SemiBold" Foreground="#F5F7FF" Text="接続を準備しています。" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageDescription" Margin="0,12,0,0" Foreground="#B6C1D9" TextWrapping="Wrap" />
                    <StackPanel x:Name="FallbackActions" Margin="0,20,0,0" Orientation="Horizontal" Visibility="Collapsed">
                        <Button x:Name="ContinueLocalButton" Margin="0,0,8,0" Padding="16,8" Click="ContinueLocalButton_Click" Content="このPCで続ける" />
                        <Button x:Name="OpenSettingsButton" Margin="0,0,8,0" Padding="16,8" Click="OpenSettingsButton_Click" Content="接続先を設定" />
                        <Button x:Name="FallbackExitButton" Padding="16,8" Click="ExitButton_Click" Content="終了" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
