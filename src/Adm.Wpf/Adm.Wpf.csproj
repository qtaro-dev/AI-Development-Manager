<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <ProjectReference Include="..\Adm.Application\Adm.Application.csproj" />
    <ProjectReference Include="..\Adm.Core\Adm.Core.csproj" />
    <ProjectReference Include="..\Adm.Infrastructure.Windows\Adm.Infrastructure.Windows.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <WebProjectDirectory>$(MSBuildThisFileDirectory)..\Adm.Web</WebProjectDirectory>
    <WebAssetSourceDirectory>$(WebProjectDirectory)\dist</WebAssetSourceDirectory>
    <WpfWebAssetOutputDirectory>$(MSBuildThisFileDirectory)..\..\artifacts\bin\$(MSBuildProjectName)\$(Configuration)\$(TargetFramework)\WebAssets</WpfWebAssetOutputDirectory>
    <ProductIconPath>$(BaseIntermediateOutputPath)Product.ico</ProductIconPath>
    <ApplicationIcon>$(ProductIconPath)</ApplicationIcon>
  </PropertyGroup>

  <Target Name="GenerateWpfProductIcon" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\scripts\installer\New-ProductIcon.ps1&quot; -OutputPath &quot;$(ProductIconPath)&quot;" />
  </Target>

  <Target Name="BuildWpfWebAssets" BeforeTargets="Build;Publish" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="node &quot;$(MSBuildThisFileDirectory)..\..\scripts\web\Build-WebAssets.mjs&quot;" WorkingDirectory="$(WebProjectDirectory)" />
    <ItemGroup>
      <WpfWebAssetFiles Include="$(WebAssetSourceDirectory)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(WpfWebAssetOutputDirectory)" />
    <MakeDir Directories="$(WpfWebAssetOutputDirectory)" />
    <Copy SourceFiles="@(WpfWebAssetFiles)" DestinationFiles="@(WpfWebAssetFiles->'$(WpfWebAssetOutputDirectory)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- dotnet publish uses a separate output directory. Copy the already-built SPA
       into that directory so the self-contained MSI input contains WebAssets. -->
  <Target Name="CopyWpfWebAssetsToPublish" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' And '$(PublishDir)' != ''">
    <ItemGroup>
      <PublishedWpfWebAssetFiles Include="$(WebAssetSourceDirectory)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)WebAssets" />
    <MakeDir Directories="$(PublishDir)WebAssets" />
    <Copy SourceFiles="@(PublishedWpfWebAssetFiles)" DestinationFiles="@(PublishedWpfWebAssetFiles->'$(PublishDir)WebAssets\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
