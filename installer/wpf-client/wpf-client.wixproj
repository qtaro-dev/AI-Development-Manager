<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <DebugType>none</DebugType>
    <Cultures>ja-JP</Cultures>
    <OutputName>AI-Development-Manager-Client-$(ProductVersion)-$(BuildNumber)-x64</OutputName>
    <!-- ICE91 is an intentional per-user MSI warning; ICE38/ICE64 remain enabled. -->
    <SuppressIces>ICE91</SuppressIces>
    <ClientPublishDir Condition="'$(ClientPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\package-input\wpf-client</ClientPublishDir>
    <GeneratedClientFiles Condition="'$(GeneratedClientFiles)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\installer-generated\ClientFiles.wxs</GeneratedClientFiles>
    <ProductIconPath Condition="'$(ProductIconPath)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\installer-generated\Product.ico</ProductIconPath>
    <DefineConstants>ProductVersion=$(ProductVersion);BuildNumber=$(BuildNumber);ClientPublishDir=$(ClientPublishDir);ProductIconPath=$(ProductIconPath)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
    <Compile Include="$(GeneratedClientFiles)" Condition="Exists('$(GeneratedClientFiles)')" />
  </ItemGroup>
</Project>
