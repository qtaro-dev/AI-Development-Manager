{
  "openapi": "3.0.4",
  "info": {
    "title": "Adm.Server.Host | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "GetLiveness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "GetReadiness",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Returns the API version and protocol readiness.",
        "operationId": "GetApiVersion",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiVersionResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdmProblemDetails": {
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "messageKey",
          "inputRetained",
          "retryable",
          "nextAction",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "messageKey": {
            "type": "string"
          },
          "inputRetained": {
            "type": "boolean"
          },
          "retryable": {
            "type": "boolean"
          },
          "nextAction": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      },
      "ApiStatus": {
        "enum": [
          "ready"
        ]
      },
      "ApiVersionResponse": {
        "required": [
          "apiVersion",
          "contractVersion",
          "serverTimeUtc",
          "status",
          "resourceId"
        ],
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string"
          },
          "contractVersion": {
            "type": "string"
          },
          "serverTimeUtc": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/ApiStatus"
          },
          "resourceId": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "System"
    }
  ]
}
